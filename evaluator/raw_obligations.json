  "brief_sentences": [
    {
      "text": "A user selects one project from a list and sees **seven read-only attributes**: title, category, phase, owner, milestone start, milestone end, and reference code.",
      "obligations": [
        "project-selection",
        "field-title",
        "field-category",
        "field-phase",
        "field-owner",
        "field-start",
        "field-end",
        "field-ref"
      ]
    },
    {
      "text": "Values must come from the persisted project record, not placeholder responses.",
      "obligations": [
        "record-backed-values"
      ]
    },
    {
      "text": "Users can edit notes, save them, and revisit the project to see the saved value.",
      "obligations": [
        "saved-value-survives-revisit",
        "edit-notes",
        "save-notes"
      ]
    },
    {
      "text": "The **Export XLSX** control is disabled before saving and becomes available after a successful save; its downloaded workbook must contain all seven attributes and the saved notes.",
      "obligations": [
        "export-xlsx",
        "export-after-save"
      ]
    },
    {
      "text": "A viewer must not be able to submit changes.",
      "obligations": [
        "viewer-write-rejected"
      ]
    },
    {
      "text": "The page, API, and database must work together in a fresh environment.",
      "obligations": [
        "real-system-integration"
      ]
    }
  ]
